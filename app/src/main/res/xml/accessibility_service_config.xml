<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately narrow: we only need scroll events and the window-state-change events
  that tell us which package is now in the foreground. We do NOT request
  canRetrieveWindowContent, flagRequestFilterKeyEvents, or any capability beyond
  what scroll-detection + drawing the interruption overlay require.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewScrolled|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRequestFilterKeyEvents="false"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100" />
